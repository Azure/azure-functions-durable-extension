<Project>
  <PropertyGroup>
    <!-- Suppress EOL target framework warnings for legacy TFMs we still multi-target. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <!-- Suppress NU1510 pruning warnings treated as errors in .NET 10. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
</Project>
