<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local-packages" value="./local-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!--
    Package source mapping ensures that the Worker extension under test is ONLY
    resolved from the local-packages feed. This prevents NuGet from silently
    falling back to nuget.org and pulling an older published version.
    All other packages fall through to nuget.org.
  -->
  <packageSourceMapping>
    <packageSource key="local-packages">
      <package pattern="Microsoft.Azure.Functions.Worker.Extensions.DurableTask" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
