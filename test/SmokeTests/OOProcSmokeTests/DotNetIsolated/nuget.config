<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear/>
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json"/>
		<add key="local" value="/home/runner/packages" />
		<add key="durabletask" value="https://azfunc.pkgs.visualstudio.com/public/_packaging/durabletask/nuget/v3/index.json" />
	</packageSources>
	<packageSourceMapping>
		<packageSource key="durabletask">
			<package pattern="Microsoft.Azure.DurableTask.Core" />
			<package pattern="Microsoft.Azure.DurableTask.AzureStorage" />
		</packageSource>
		<packageSource key="local">
			<package pattern="Microsoft.Azure.WebJobs.Extensions.DurableTask" />
		</packageSource>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>