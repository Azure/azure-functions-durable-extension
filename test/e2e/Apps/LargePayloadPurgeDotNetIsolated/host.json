{
  "version": "2.0",
  "extensions": {
    "durableTask": {
      "hubName": "%PurgeTestHub%",
      "defaultVersion": "2.0",
      "versionMatchStrategy": "Strict",
      "versionFailureStrategy": "Fail",
      "extendedSessionsEnabled": false
    }
  },
  "logging": {
    "logLevel": {
      "default": "Information"
    }
  }
}
