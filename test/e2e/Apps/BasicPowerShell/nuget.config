<configuration>
	<packageSources>
		<clear/>
		<add key="local" value="." />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="durabletask-testing" value="https://azfunc.pkgs.visualstudio.com/public/_packaging/durabletask-testing/nuget/v3/index.json" />
	</packageSources>
	<packageSourceMapping>
		<packageSource key="durabletask-testing">
			<package pattern="Microsoft.Azure.DurableTask.Core" />
			<package pattern="Microsoft.Azure.DurableTask.AzureStorage" />
			<package pattern="Microsoft.Azure.DurableTask.ApplicationInsights" />
			<package pattern="Microsoft.DurableTask.Abstractions" />
			<package pattern="Microsoft.DurableTask.Client" />
			<package pattern="Microsoft.DurableTask.Client.Grpc" />
			<package pattern="Microsoft.DurableTask.Grpc" />
			<package pattern="Microsoft.DurableTask.Worker" />
			<package pattern="Microsoft.DurableTask.Worker.Grpc" />
		</packageSource>
		<packageSource key="local">
			<package pattern="Microsoft.Azure.WebJobs.Extensions.DurableTask" />
		</packageSource>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
